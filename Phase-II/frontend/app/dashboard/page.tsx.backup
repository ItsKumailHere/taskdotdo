'use client';

import React from 'react';
import ProtectedRoute from '@/components/auth/ProtectedRoute';
import { jwtDecode } from 'jwt-decode';

interface TokenPayload {
  sub: string;
  email: string;
  role: string;
  exp: number;
}

const DashboardPage = () => {
  // Get user info from the token
  const token = typeof window !== 'undefined' ? localStorage.getItem('access_token') : null;
  let userEmail = '';
  let userId = '';
  let userRole = '';

  if (token) {
    try {
      const decoded: TokenPayload = jwtDecode(token);
      userEmail = decoded.email;
      userId = decoded.sub;
      userRole = decoded.role;
    } catch (error) {
      console.error('Error decoding token:', error);
    }
  }

  return (
    <ProtectedRoute>
      <div className="min-h-screen bg-gray-50">
        <header className="bg-white shadow">
          <div className="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
            <h1 className="text-3xl font-bold text-gray-900">Dashboard</h1>
          </div>
        </header>
        <main>
          <div className="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
            <div className="px-4 py-6 sm:px-0">
              <div className="bg-white shadow rounded-lg p-6">
                <h2 className="text-xl font-semibold text-gray-800 mb-4">Welcome to your dashboard!</h2>
                <div className="space-y-4">
                  <div className="flex items-center">
                    <span className="font-medium text-gray-700 w-32">User ID:</span>
                    <span className="text-gray-900">{userId}</span>
                  </div>
                  <div className="flex items-center">
                    <span className="font-medium text-gray-700 w-32">Email:</span>
                    <span className="text-gray-900">{userEmail}</span>
                  </div>
                  <div className="flex items-center">
                    <span className="font-medium text-gray-700 w-32">Role:</span>
                    <span className="text-gray-900">{userRole}</span>
                  </div>
                </div>
                <div className="mt-8">
                  <h3 className="text-lg font-medium text-gray-800 mb-2">Your Tasks</h3>
                  <p className="text-gray-600">You don't have any tasks yet. Get started by creating your first task!</p>
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </ProtectedRoute>
  );
};

export default DashboardPage;