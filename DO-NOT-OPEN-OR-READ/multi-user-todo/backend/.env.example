# Database Configuration
# For Neon PostgreSQL, use postgresql+asyncpg://
# Remove ?sslmode=require from the URL - SSL is configured in the engine
# Example: postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/database
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/database

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days in minutes
JWT_REFRESH_TOKEN_EXPIRE_DAYS=90

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Application Configuration
APP_NAME="Multi-User Todo Application"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Security
SECRET_KEY=your-app-secret-key-here-change-in-production

# Session Configuration
SESSION_EXPIRE_DAYS=90
SINGLE_DEVICE_LOGIN=True
